# ==========================================
# SurplusLink AI - Frontend Environment Config
# ==========================================

# Base URL of the unified FastAPI backend.
# Local: http://127.0.0.1:8000
# Production: https://<your-render-service>.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# false = use the live FastAPI backend.
# true = offline demo mode with local mock simulation; no backend required.
VITE_USE_MOCK_DATA=false

# Mock AI extraction simulated delay (ms) for offline demonstration
VITE_MOCK_DELAY_MS=600

# Default Rescue Session Join Code
VITE_DEFAULT_JOIN_CODE=RESCUE-7QK2
