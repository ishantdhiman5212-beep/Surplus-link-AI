# -----------------------------
# Database
# -----------------------------
# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/surplus_link_ai

# Neon examples (copy one; URL-encode special characters in the password)
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/surplus_link_ai?sslmode=require
# DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/surplus_link_ai?sslmode=require

# -----------------------------
# Application / auth
# -----------------------------
ENVIRONMENT=development
PROJECT_NAME=SurplusLink AI

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated origins allowed by the React/Vite frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Set to true only for throwaway local databases. Use Alembic in production.
CREATE_TABLES_ON_STARTUP=false

# NGO operating hours are local wall-clock times; deadlines are stored in UTC.
MATCHING_TIME_ZONE=Asia/Kolkata
MATCHING_UTC_OFFSET_HOURS=5.5

# -----------------------------
# AI extraction (all optional)
# -----------------------------
# The extractor tries, in order: Gemini, OpenAI, xAI, then local heuristics.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_API_KEY=
XAI_MODEL=grok-2-latest
AI_TIMEOUT_SECONDS=8.0
